PORT=8080
PUBLIC_URL=https://activate.lenzorium.com
DB_PATH=/var/lib/lenzorium/lenzorium.db
TRUST_PROXY=1
TRIAL_DAYS=7

# Stripe (website payments for the direct-download apps)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_YEARLY=price_...
STRIPE_PRICE_LIFETIME=price_...

# Reseller credit cost per activation
CREDITS_YEARLY=1
CREDITS_LIFETIME=3

# Long random string for the admin API (create resellers, add credits)
ADMIN_TOKEN=change-me

# Testing only, with no Stripe key: activates without payment
# DEV_ACTIVATE=1
